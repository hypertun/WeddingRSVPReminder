# ==============================================================================
# Wedding RSVP Multi-Channel Configuration (.env)
# ==============================================================================

# --- GENERAL DISPATCH SETTINGS ---
# Channels to send: whatsapp, telegram (or just whatsapp)
CHANNELS=whatsapp,telegram

# Delay in seconds between each recipient (default: 6.0)
DISPATCH_DELAY=6.0


# --- TELEGRAM CONFIGURATION ---
# Get your free API ID and API Hash from https://my.telegram.org:
# 1. Log in with your phone number on my.telegram.org
# 2. Go to "API development tools"
# 3. Create an app (name can be "RSVP") to get your api_id and api_hash
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=


# --- WHATSAPP CONFIGURATION ---
# Method choices: "api" (no browser/no QR code) or "playwright" (WhatsApp Web browser)
WHATSAPP_METHOD=api

# Option A: Twilio for WhatsApp (API - recommended for no-browser setup)
# Sign up at https://www.twilio.com and get your credentials from the Console:
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# Option B: Meta WhatsApp Cloud API (Alternative API)
# Official Meta Graph API:
META_WA_PHONE_NUMBER_ID=
META_WA_ACCESS_TOKEN=

# Option C: Green API (Alternative API for personal WhatsApp numbers)
GREEN_API_INSTANCE_ID=
GREEN_API_TOKEN=
